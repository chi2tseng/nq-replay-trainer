# raw vendor data dumps (large; converted JSON in data/*.json is what the app uses)
data/duka/
data/duka_test/

node_modules/
__pycache__/
*.log
*.output
.DS_Store
Thumbs.db

# databento raw dumps + key
data/*_db*.csv
scripts/.db_key

# 10-year per-year NQ history (~400MB total) — local backtesting only, NOT served by the app
data/NQ_y20*.json

# per-day tick (trades) replay files — fetched on demand, local-only (too big for GitHub)
data/tick/

# raw build inputs for the multi-res blend + deep-history monthly chunks (scripts/merge_multires.py,
# scripts/split_monthly.py): each is 400MB+ per symbol, way over GitHub's 100MB/file limit, and the
# app never fetches these directly — only their OUTPUTS (data/*_multi.json, data/chunks/<SYM>/*.json,
# both git-tracked) are served. Resume-manifest sidecars are pure build bookkeeping, same reason.
data/*_db_15s.json
data/*_db_5s.json
data/*.weeks
